LOG_LEVEL=info

# HTTP host
HOST__API_PORT=5000
HOST__BODY_LIMIT_BYTES=4194304
# Empty binds every interface.
HOST__LISTEN_ADDRESS=

TELEMETRY__ENABLED=false
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=false
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=

# One block per chain. Past receipt_timeout_seconds, /settle answers settlement_pending.
CHAINS__80002__RPC_HTTP_URL=
CHAINS__80002__REQUEST_TIMEOUT_SECONDS=10
CHAINS__80002__CONFIRMATIONS=1
CHAINS__80002__RECEIPT_TIMEOUT_SECONDS=120
# Required on every chain: with access.agents_only, startup refuses a mix of testnet and mainnet chains.
CHAINS__80002__TESTNET=true

# Settleable tokens: asset_transfer_methods (eip3009 by default, permit2), plus the EIP-712 domain for eip3009.
TOKENS__80002__0X41E94EB019C0762F9BFCF9FB1E58725BFB0E7582__ASSET_TRANSFER_METHODS=eip3009,permit2
TOKENS__80002__0X41E94EB019C0762F9BFCF9FB1E58725BFB0E7582__EIP712_NAME=USDC
TOKENS__80002__0X41E94EB019C0762F9BFCF9FB1E58725BFB0E7582__EIP712_VERSION=2
TOKENS__80002__0X26ADAF578361953E8F1AC86D3E4CA153493AF5CB__ASSET_TRANSFER_METHODS=permit2

# agents_only: payTo must be a 6022 agent address on a configured chain.
# Then testnet and mainnet chains can't be mixed: startup refuses it.
ACCESS__AGENTS_ONLY=true
ACCESS__CACHE_TTL_SECONDS=300

# Lock kept by a settlement whose replica dies mid-way.
SETTLEMENT__LOCK_TTL_SECONDS=600

# Required, shared by every replica. Host is host:port.
REDIS__HOST=
REDIS__PASSWORD=
REDIS__DB=0

# Vault KV v1 secret <relayer.vault_key>, field private_key: the wallet paying the gas.
VAULT__ADDRESS=
VAULT__TOKEN=
VAULT__KV_V1_MOUNT_PATH=secret
RELAYER__VAULT_KEY=relayer
