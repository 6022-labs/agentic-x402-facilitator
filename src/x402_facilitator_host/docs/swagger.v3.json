    "info": {
        "description": "x402 v2 facilitator: verifies and settles exact EIP-3009 payments.",
        "title": "Agentic x402 Facilitator API",
        "version": "1.0"
    },
    "externalDocs": {
        "description": "",
        "url": ""
    },
    "paths": {
        "/health": {
            "get": {
                "description": "Liveness probe for the x402 facilitator.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.GetHealthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Health check",
                "tags": [
                    "Health"
                ]
            }
        },
        "/settle": {
            "post": {
                "description": "Verifies, submits and waits for an exact EIP-3009 payment; a refused one answers 200, success false.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/requests.SettlePaymentRequest",
                                        "summary": "body",
                                        "description": "payment payload and requirements"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "payment payload and requirements",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.SettlePaymentResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.BadRequestError"
                                }
                            }
                        },
                        "description": "invalid_body"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "502": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.UnavailableError"
                                }
                            }
                        },
                        "description": "unavailable dependency, or settlement_in_progress"
                    }
                },
                "summary": "Settle a payment",
                "tags": [
                    "Facilitator"
                ]
            }
        },
        "/supported": {
            "get": {
                "description": "Lists the networks it settles and the relayer address.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.GetSupportedResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "502": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.UnavailableError"
                                }
                            }
                        },
                        "description": "relayer_unavailable"
                    }
                },
                "summary": "Supported payment kinds",
                "tags": [
                    "Facilitator"
                ]
            }
        },
        "/verify": {
            "post": {
                "description": "Checks an exact EIP-3009 payment without writing on-chain; a refused one answers 200, isValid false.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/requests.VerifyPaymentRequest",
                                        "summary": "body",
                                        "description": "payment payload and requirements"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "payment payload and requirements",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.VerifyPaymentResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.BadRequestError"
                                }
                            }
                        },
                        "description": "invalid_body"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "502": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.UnavailableError"
                                }
                            }
                        },
                        "description": "registry, chain, relayer or store unavailable"
                    }
                },
                "summary": "Verify a payment",
                "tags": [
                    "Facilitator"
                ]
            }
        }
    },
    "openapi": "3.1.0",
    "servers": [
        {
            "url": "/"
        }
    ]
}